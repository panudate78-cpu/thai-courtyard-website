# Thai Courtyard white-label template — copy to .env.local and fill in
# Clone → Neon → Vercel Blob → envs → domain → /setup in <1 hour

# --- Database (Neon Postgres) ---
# Create a Neon project (neon.tech) → copy its connection string
# e.g. postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://user:password@host/neondb?sslmode=require

# --- Site URL (canonical domain, no trailing slash) ---
NEXT_PUBLIC_SITE_URL=https://www.example.co.uk
# Optional overrides (fallback to restaurant_config after setup)
NEXT_PUBLIC_CONTACT_EMAIL=info@example.co.uk
NEXT_PUBLIC_GOOGLE_PLACE_ID=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# --- Admin & Setup ---
# Admin fallback (hashed in DB after /setup; env remains fallback for Thai Courtyard live)
ADMIN_PASSWORD=change-me-please-12+chars
ADMIN_SESSION_SECRET=random-32+chars-for-cookie-signing
# Protect the /setup wizard — share only with the client (re-open via Admin → Restaurant → Re-open Setup)
SETUP_TOKEN=change-me-setup-token

# --- Email (pick one provider) ---
# Option A: SMTP (e.g. Brevo, Gmail app password, Postmark SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=Restaurant Name <info@example.co.uk>
EMAIL_FROM=Restaurant Name <info@example.co.uk>
RESTAURANT_EMAIL=orders@example.co.uk
ORDER_NOTIFICATION_EMAIL=orders@example.co.uk

# Option B: Resend (alternative to SMTP)
# RESEND_API_KEY=re_xxx

# --- Images / Uploads (Vercel Blob) ---
# Vercel Dashboard → Storage → Create Blob Store → copy token → add to env
# Without this, Step 5 uploads in /setup will show a clear error and block until set
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- Payments (optional — Stripe) ---
# Default is "pay_on_collection" — no Stripe needed and no Stripe SDK calls are made.
# To accept online payments, set payment_mode to "stripe_online" or "customer_choice" in /setup (or Admin → Restaurant → Collection payments)
# and set these three env vars in Vercel + .env.local. If omitted, pay_on_collection stays the default and build still passes.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe webhook endpoint: https://www.example.co.uk/api/webhooks/stripe  (events: checkout.session.completed)

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=G-XXXXXXX
NEXT_PUBLIC_GOOGLE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Cron / Maintenance (optional) ---
CRON_SECRET=random-32+chars
