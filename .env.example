# ── Required ─────────────────────────────────────────────────────────────
# Neon (or any PostgreSQL) connection string. On Vercel this is injected
# automatically when you connect a Neon database to the project.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Strongly recommended ────────────────────────────────────────────────
# Admin password for /admin. If unset, the demo password "admin123" is used
# and a warning is shown in the admin. ALWAYS set this before going live.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: secret used to sign the admin session cookie. Set a long random
# string in production so sessions survive password rotation policies.
ADMIN_SESSION_SECRET=

# Public URL of the deployed site (no trailing slash). Used for SEO
# canonicals, sitemap and social sharing images.
NEXT_PUBLIC_SITE_URL=https://www.your-restaurant.co.uk

# ── Optional ────────────────────────────────────────────────────────────
# Email notifications (order/booking alerts + customer confirmations).
# Option A: Resend (https://resend.com) — set RESEND_API_KEY.
# Option B: any SMTP server (Gmail app password, your host, etc.).
# Without either, the site still works — orders/bookings appear in the
# admin and emails are simply skipped.
RESEND_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Your Restaurant <no-reply@example.com>"
EMAIL_FROM=
# Where order/booking alerts go (defaults to the Business Settings email).
RESTAURANT_EMAIL=
ORDER_NOTIFICATION_EMAIL=

# Google Business Profile (optional; can also be set in Business Settings)
NEXT_PUBLIC_GOOGLE_PLACE_ID=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Future: Stripe online payments (architecture in place, checkout not yet
# active — the publishable key lives in Business Settings; the secret key
# must only ever be an environment variable).
STRIPE_SECRET_KEY=

# Cap DB connections per server instance (useful on Neon free tier).
# DB_POOL_MAX=5
